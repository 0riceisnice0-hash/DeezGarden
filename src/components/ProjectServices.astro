---
const cards = [
  {title:'Complete landscaping',href:'/services/landscaping/',image:'family-garden-turf-gravel-after.webp',copy:'Turn an overgrown or awkward garden into a usable outdoor space, with clearance, ground preparation and the finished layout.'},
  {title:'Patios & paving',href:'/services/patios-paving/',image:'large-patio-after.webp',copy:'New patios, paved paths, steps and edging. A defined space for seating, entertaining and access through the garden.'},
  {title:'Turf & artificial lawns',href:'/services/turfing-lawns/',image:'small-garden-turf-after.webp',copy:'New lawns with ground preparation and timber edging, or an artificial lawn as part of your garden makeover.'},
  {title:'Garden renovations',href:'/services/garden-renovations/',image:'artificial-lawn-patio-after.webp',copy:'Rebuild tired gardens with new levels, steps, gravel, raised beds and a layout that works for your household.'},
];
---
<section class="py-8 md:py-14 bg-bg-sage" aria-labelledby="landscaping-services">
  <div class="container mx-auto px-4 max-w-6xl">
    <h2 id="landscaping-services" class="text-2xl md:text-3xl font-extrabold text-center mb-3">Landscaping services for your garden project</h2>
    <p class="text-center text-gray-700 max-w-3xl mx-auto mb-7">Choose a complete makeover or a specific installation. We quote for the agreed work, materials and preparation.</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {cards.map(card => <a href={card.href} class="group rounded-2xl overflow-hidden bg-white shadow-md hover:shadow-xl transition border border-fresh-green/20">
        <img src={`/assets/images/projects-2026/${card.image}`} alt={card.title} width="900" height="1200" loading="lazy" decoding="async" class="w-full aspect-[4/3] object-cover" />
        <div class="p-5"><h3 class="text-xl font-bold text-deep-green mb-2">{card.title}</h3><p class="text-sm text-gray-700 mb-4">{card.copy}</p><span class="font-bold text-fresh-green group-hover:underline">Explore this service →</span></div>
      </a>)}
    </div>
    <p class="text-center mt-6 text-gray-700">Need the plot cleared first? <a class="font-bold text-deep-green underline" href="/services/garden-clearance/">Garden clearance</a> and <a class="font-bold text-deep-green underline" href="/services/hedge-cutting/">hedge reduction</a> can be quoted as standalone jobs or included in a makeover.</p>
  </div>
</section>
