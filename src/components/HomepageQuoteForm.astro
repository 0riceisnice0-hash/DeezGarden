---
import { siteConfig } from '../config';

// Normalise baseUrl so there's never a double-slash before /thank-you/
const thankyouUrl = `${siteConfig.baseUrl.replace(/\/$/, '')}/thank-you/`;

// Services with emoji icons for the interactive selector
const serviceOptions = [
  { value: "Garden Maintenance", label: "Garden Maintenance", emoji: "🌿" },
  { value: "Garden Clearance", label: "Garden Clearance", emoji: "🌳" },
  { value: "Hedge Cutting", label: "Hedge Cutting", emoji: "✂️" },
  { value: "Landscaping", label: "Landscaping", emoji: "🏗️" },
  { value: "Patio or Paving", label: "Patio / Paving", emoji: "🧱" },
  { value: "Turfing or New Lawn", label: "Turf / New Lawn", emoji: "🌱" },
  { value: "Rubbish Clearance", label: "Rubbish Clearance", emoji: "🚛" },
  { value: "Man with Van", label: "Man with Van", emoji: "🚐" },
  { value: "Property Maintenance", label: "Property Maintenance", emoji: "🔧" },
  { value: "Other", label: "Not Sure / Other", emoji: "💬" },
];
---

<!-- Quote Form Modal -->
<div
  id="quote-modal"
  class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="quote-modal-title"
>
  <!-- Backdrop -->
  <div id="quote-modal-backdrop" class="absolute inset-0 bg-black/60"></div>

  <!-- Modal Card -->
  <div class="relative w-full max-w-2xl bg-white rounded-2xl shadow-2xl max-h-[90vh] overflow-y-auto z-10">
    <!-- Close button -->
    <button
      type="button"
      id="quote-modal-close"
      class="absolute top-3 right-3 z-20 text-gray-500 hover:text-gray-800 transition p-1 rounded-full hover:bg-gray-100"
      aria-label="Close quote form"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="p-4 md:p-6" id="homepage-quote-form">
      <!-- Form header -->
      <div class="text-center mb-3 md:mb-4 pb-3 border-b border-gray-100">
        <h2 id="quote-modal-title" class="text-lg md:text-2xl font-extrabold text-deep-green tracking-tight">Get Your Free Quote</h2>
        <p class="text-gray-600 text-xs md:text-sm mt-1">Mon–Sat 8am–6pm · No spam, just a quote</p>
        <!-- Trust strip -->
        <div class="flex flex-wrap justify-center gap-x-3 gap-y-1 mt-2 text-[11px] md:text-xs text-gray-500 font-semibold">
          <span class="inline-flex items-center gap-1"><span class="text-fresh-green">✓</span> Free &amp; no-obligation</span>
          <span class="inline-flex items-center gap-1"><span class="text-fresh-green">✓</span> Fully insured</span>
          <span class="inline-flex items-center gap-1"><span class="text-fresh-green">✓</span> Licensed waste carrier</span>
        </div>
      </div>

      <form
        action="https://formspree.io/f/mdalolve"
        method="POST"
        id="homepage-quote-form-el"
        class="space-y-3"
      >
          <input type="hidden" name="_next" value={thankyouUrl}>
          <input type="hidden" name="_subject" value="New quote request from Dee'z Gardens homepage">
          <!-- Hidden field that stores the selected service -->
          <input type="hidden" name="service" id="homepage-service-value">

          <!-- Step 1: Service selector -->
          <div>
            <p class="font-bold text-gray-800 mb-3 text-sm md:text-base">What do you need? <span class="text-red-500">*</span></p>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="service-buttons" role="group" aria-label="Select service type">
              {serviceOptions.map(opt => (
                <button
                  type="button"
                  data-service={opt.value}
                  class="service-btn flex flex-col items-center gap-1 px-2 py-2 rounded-xl border-2 border-gray-200 bg-white hover:border-fresh-green hover:bg-green-50 transition-all text-center cursor-pointer group"
                  aria-pressed="false"
                >
                  <span class="text-xl md:text-2xl leading-none">{opt.emoji}</span>
                  <span class="text-xs md:text-sm font-semibold text-gray-700 group-hover:text-deep-green leading-tight">{opt.label}</span>
                </button>
              ))}
            </div>
            <p id="service-error" class="text-red-500 text-xs mt-1.5 hidden">Please select a service type above.</p>
          </div>

          <!-- Name + Phone row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="hq-name" class="block text-sm font-bold text-gray-700 mb-1.5">Your Name <span class="text-red-500">*</span></label>
              <input
                type="text"
                id="hq-name"
                name="name"
                required
                autocomplete="name"
                placeholder="John Smith"
                class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-fresh-green focus:ring-0 transition text-sm md:text-base text-gray-900"
              >
            </div>
            <div>
              <label for="hq-phone" class="block text-sm font-bold text-gray-700 mb-1.5">Phone Number <span class="text-red-500">*</span></label>
              <input
                type="tel"
                id="hq-phone"
                name="phone"
                required
                autocomplete="tel"
                inputmode="tel"
                pattern="^(\+44\s?|0)7\d{3}\s?\d{6}$"
                title="Please enter a valid UK mobile number (e.g. 07XXX XXXXXX)"
                placeholder="07XXX XXXXXX"
                class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-fresh-green focus:ring-0 transition text-sm md:text-base text-gray-900"
              >
            </div>
          </div>

          <!-- Email (optional) -->
          <div>
            <label for="hq-email" class="block text-sm font-bold text-gray-700 mb-1.5">Email Address <span class="text-gray-400 font-normal">(optional)</span></label>
            <input
              type="email"
              id="hq-email"
              name="email"
              autocomplete="email"
              inputmode="email"
              placeholder="john@example.com"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-fresh-green focus:ring-0 transition text-sm md:text-base text-gray-900"
            >
          </div>

          <!-- Postcode (helps job sizing & travel time) -->
          <div>
            <label for="hq-postcode" class="block text-sm font-bold text-gray-700 mb-1.5">Postcode <span class="text-gray-400 font-normal">(optional, speeds up your quote)</span></label>
            <input
              type="text"
              id="hq-postcode"
              name="postcode"
              autocomplete="postal-code"
              placeholder="NN1 1AA"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-fresh-green focus:ring-0 transition text-sm md:text-base text-gray-900 uppercase"
            >
          </div>

          <!-- How did you hear about us (optional) -->
          <div>
            <label for="hq-referral-source" class="block text-sm font-bold text-gray-700 mb-1.5">How Did You Hear About Us? <span class="text-gray-400 font-normal">(optional)</span></label>
            <select
              id="hq-referral-source"
              name="referral_source"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-fresh-green focus:ring-0 transition text-sm md:text-base text-gray-900"
            >
              <option value="">Please select...</option>
              <option value="Google">Google</option>
              <option value="Facebook">Facebook</option>
              <option value="Instagram">Instagram</option>
              <option value="Word of Mouth">Word of Mouth</option>
              <option value="Flyer / Leaflet">Flyer / Leaflet</option>
              <option value="Recommendation">Recommendation</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <!-- Message -->
          <div>
            <label for="hq-message" class="block text-sm font-bold text-gray-700 mb-1.5">Tell us more <span class="text-gray-400 font-normal">(optional)</span></label>
            <textarea
              id="hq-message"
              name="message"
              rows="3"
              placeholder="e.g. My garden is overgrown, roughly 20m x 10m, needs full clearance…"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-fresh-green focus:ring-0 transition resize-none text-sm md:text-base text-gray-900"
            ></textarea>
          </div>

          <!-- Submit -->
          <div>
            <button
              type="submit"
              id="hq-submit-btn"
              class="w-full bg-fresh-green text-white font-extrabold text-base md:text-lg py-3.5 rounded-xl hover:bg-deep-green transition-all shadow-lg hover:shadow-xl tracking-tight flex items-center justify-center gap-2"
            >
              <span id="hq-btn-text">Send My Free Quote — Reply within 2hrs ✓</span>
              <svg id="hq-spinner" class="hidden w-5 h-5 animate-spin text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
              </svg>
            </button>
          </div>

          <!-- Alternative contact methods -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
            <a
              href={`tel:${siteConfig.phone}`}
              class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl border-2 border-deep-green text-deep-green font-bold text-sm hover:bg-deep-green hover:text-white transition"
            >
              📞 Call {siteConfig.phoneFormatted}
            </a>
            {siteConfig.whatsapp && (
              <a
                href={siteConfig.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-[#25D366] text-white font-bold text-sm hover:bg-[#1da851] transition"
              >
                💬 Send via WhatsApp
              </a>
            )}
          </div>

          <p class="text-center text-[11px] text-gray-400 mt-2">
            We'll only use your details to reply about your quote. No spam, ever.
          </p>
        </form>
    </div>
  </div>
</div>

<style>
  .service-btn.selected {
    border-color: theme('colors.fresh-green');
    background-color: theme('colors.bg-light');
  }
  .service-btn.selected span:last-child {
    color: theme('colors.deep-green');
    font-weight: 700;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('quote-modal');
    const backdrop = document.getElementById('quote-modal-backdrop');
    const closeBtn = document.getElementById('quote-modal-close');
    const buttons = document.querySelectorAll<HTMLButtonElement>('.service-btn');
    const hiddenInput = document.getElementById('homepage-service-value') as HTMLInputElement | null;
    const serviceError = document.getElementById('service-error');
    const form = document.getElementById('homepage-quote-form-el') as HTMLFormElement | null;
    const submitBtn = document.getElementById('hq-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('hq-btn-text');
    const spinner = document.getElementById('hq-spinner');

    let userClosedThisSession = false;

    function openModal() {
      if (!modal) return;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      const w = window as any;
      if (typeof w.gtag === 'function') {
        w.gtag('event', 'open_quote_modal', { event_category: 'engagement' });
      }
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      userClosedThisSession = true;
      try { sessionStorage.setItem('quote_modal_dismissed', '1'); } catch {}
    }

    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);

    document.querySelectorAll('.quote-cta-btn').forEach(btn => {
      btn.addEventListener('click', openModal);
    });

    document.getElementById('hero-quote-btn')?.addEventListener('click', openModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => {
          b.classList.remove('selected');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('selected');
        btn.setAttribute('aria-pressed', 'true');
        if (hiddenInput) hiddenInput.value = btn.dataset.service || '';
        if (serviceError) serviceError.classList.add('hidden');
      });
    });

    form?.addEventListener('submit', (e) => {
      if (!hiddenInput?.value) {
        e.preventDefault();
        if (serviceError) serviceError.classList.remove('hidden');
        document.getElementById('service-buttons')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      if (btnText) btnText.textContent = 'Sending…';
      if (spinner) spinner.classList.remove('hidden');
      if (submitBtn) submitBtn.disabled = true;
      const w = window as any;
      if (typeof w.gtag === 'function') {
        w.gtag('event', 'generate_lead', {
          event_category: 'conversion',
          service: hiddenInput.value,
        });
      }
      try { (window as any).dataLayer?.push({ event: 'generate_lead', service: hiddenInput.value, source: 'quote_modal' }); } catch {}
    });

    // Auto-open: site-wide, once per session, after 60% scroll OR 35s OR exit-intent (desktop).
    // Skipped on contact / thank-you pages where a form is already prominent.
    const path = window.location.pathname.replace(/\/+$/, '');
    const skipPaths = ['/contact', '/thank-you'];
    const autoOpenAllowed = !skipPaths.some(p => path === p || path.endsWith(p));
    let alreadyDismissed = false;
    try { alreadyDismissed = sessionStorage.getItem('quote_modal_dismissed') === '1'; } catch {}
    let alreadyAutoOpened = false;

    function maybeAutoOpen(reason: string) {
      if (!autoOpenAllowed || alreadyAutoOpened || alreadyDismissed || userClosedThisSession) return;
      if (modal && !modal.classList.contains('hidden')) return;
      alreadyAutoOpened = true;
      openModal();
      const w = window as any;
      if (typeof w.gtag === 'function') {
        w.gtag('event', 'auto_open_quote_modal', { event_category: 'engagement', trigger: reason });
      }
      try { (window as any).dataLayer?.push({ event: 'auto_open_quote_modal', trigger: reason }); } catch {}
    }

    if (autoOpenAllowed && !alreadyDismissed) {
      // Time-based trigger
      setTimeout(() => maybeAutoOpen('time'), 35000);
      // Scroll-based trigger
      const onScroll = () => {
        const scrolled = window.scrollY + window.innerHeight;
        const total = document.documentElement.scrollHeight;
        if (total > 0 && scrolled / total >= 0.6) {
          maybeAutoOpen('scroll');
          window.removeEventListener('scroll', onScroll);
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      // Exit-intent (desktop only — mouse leaves toward top of viewport)
      const onMouseOut = (e: MouseEvent) => {
        if (e.clientY <= 0 && window.innerWidth >= 1024) {
          maybeAutoOpen('exit_intent');
          document.removeEventListener('mouseout', onMouseOut);
        }
      };
      document.addEventListener('mouseout', onMouseOut);
    }
  });
</script>
