---
import { siteConfig } from '../config';

// Normalise baseUrl so there's never a double-slash before /thank-you/
const thankyouUrl = `${siteConfig.baseUrl.replace(/\/$/, '')}/thank-you/`;

// Services with emoji icons for the interactive selector
const serviceOptions = [
  { value: "Garden Maintenance", label: "Garden Maintenance", emoji: "🌿" },
  { value: "Garden Clearance", label: "Garden Clearance", emoji: "🌳" },
  { value: "Hedge Cutting", label: "Hedge Cutting", emoji: "✂️" },
  { value: "Landscaping", label: "Landscaping", emoji: "🏗️" },
  { value: "Rubbish Clearance", label: "Rubbish Clearance", emoji: "🚛" },
  { value: "Man with Van", label: "Man with Van", emoji: "🚐" },
  { value: "Property Maintenance", label: "Property Maintenance", emoji: "🔧" },
  { value: "Other", label: "Not Sure / Other", emoji: "💬" },
];
---

&lt;!-- Quote Form Modal --&gt;
&lt;div
  id="quote-modal"
  class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="quote-modal-title"
&gt;
  &lt;!-- Backdrop --&gt;
  &lt;div id="quote-modal-backdrop" class="absolute inset-0 bg-black/60"&gt;&lt;/div&gt;

  &lt;!-- Modal Card --&gt;
  &lt;div class="relative w-full max-w-2xl bg-white rounded-2xl shadow-2xl max-h-[90vh] overflow-y-auto z-10"&gt;
    &lt;!-- Close button --&gt;
    &lt;button
      type="button"
      id="quote-modal-close"
      class="absolute top-3 right-3 z-20 text-gray-500 hover:text-gray-800 transition p-1 rounded-full hover:bg-gray-100"
      aria-label="Close quote form"
    &gt;
      &lt;svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"&gt;
        &lt;path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /&gt;
      &lt;/svg&gt;
    &lt;/button&gt;

    &lt;div class="p-4 md:p-6" id="homepage-quote-form"&gt;
      &lt;!-- Form header --&gt;
      &lt;div class="text-center mb-3 md:mb-4 pb-3 border-b border-gray-100"&gt;
        &lt;h2 id="quote-modal-title" class="text-lg md:text-2xl font-extrabold text-deep-green tracking-tight"&gt;Get Your Free Quote in 60 Seconds&lt;/h2&gt;
        &lt;p class="text-gray-600 text-xs md:text-sm mt-1"&gt;Reply within 2 hours · Mon–Sat 8am–6pm · No spam, just a quote&lt;/p&gt;
        &lt;!-- Trust strip --&gt;
        &lt;div class="flex flex-wrap justify-center gap-x-3 gap-y-1 mt-2 text-[11px] md:text-xs text-gray-500 font-semibold"&gt;
          &lt;span class="inline-flex items-center gap-1"&gt;&lt;span class="text-fresh-green"&gt;✓&lt;/span&gt; Free &amp;amp; no-obligation&lt;/span&gt;
          &lt;span class="inline-flex items-center gap-1"&gt;&lt;span class="text-fresh-green"&gt;✓&lt;/span&gt; Fully insured&lt;/span&gt;
          &lt;span class="inline-flex items-center gap-1"&gt;&lt;span class="text-fresh-green"&gt;✓&lt;/span&gt; Licensed waste carrier&lt;/span&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      &lt;form
        action="https://formspree.io/f/mdalolve"
        method="POST"
        id="homepage-quote-form-el"
        class="space-y-3"
      &gt;
          &lt;input type="hidden" name="_next" value={thankyouUrl}&gt;
          &lt;input type="hidden" name="_subject" value="New quote request from Dee'z Gardens homepage"&gt;
          &lt;!-- Hidden field that stores the selected service --&gt;
          &lt;input type="hidden" name="service" id="homepage-service-value"&gt;

          &lt;!-- Step 1: Service selector --&gt;
          &lt;div&gt;
            &lt;p class="font-bold text-gray-800 mb-3 text-sm md:text-base"&gt;What do you need? &lt;span class="text-red-500"&gt;*&lt;/span&gt;&lt;/p&gt;
            &lt;div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="service-buttons" role="group" aria-label="Select service type"&gt;
              {serviceOptions.map(opt =&gt; (
                &lt;button
                  type="button"
                  data-service={opt.value}
                  class="service-btn flex flex-col items-center gap-1 px-2 py-2 rounded-xl border-2 border-gray-200 bg-white hover:border-fresh-green hover:bg-green-50 transition-all text-center cursor-pointer group"
                  aria-pressed="false"
                &gt;
                  &lt;span class="text-xl md:text-2xl leading-none"&gt;{opt.emoji}&lt;/span&gt;
                  &lt;span class="text-xs md:text-sm font-semibold text-gray-700 group-hover:text-deep-green leading-tight"&gt;{opt.label}&lt;/span&gt;
                &lt;/button&gt;
              ))}
            &lt;/div&gt;
            &lt;p id="service-error" class="text-red-500 text-xs mt-1.5 hidden"&gt;Please select a service type above.&lt;/p&gt;
          &lt;/div&gt;

          &lt;!-- Name + Phone row --&gt;
          &lt;div class="grid grid-cols-1 sm:grid-cols-2 gap-4"&gt;
            &lt;div&gt;
              &lt;label for="hq-name" class="block text-sm font-bold text-gray-700 mb-1.5"&gt;Your Name &lt;span class="text-red-500"&gt;*&lt;/span&gt;&lt;/label&gt;
              &lt;input
                type="text"
                id="hq-name"
                name="name"
                required
                autocomplete="name"
                placeholder="John Smith"
                class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-fresh-green focus:ring-0 transition text-sm md:text-base text-gray-900"
              &gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;label for="hq-phone" class="block text-sm font-bold text-gray-700 mb-1.5"&gt;Phone Number &lt;span class="text-red-500"&gt;*&lt;/span&gt;&lt;/label&gt;
              &lt;input
                type="tel"
                id="hq-phone"
                name="phone"
                required
                autocomplete="tel"
                inputmode="tel"
                pattern="^(\+44\s?|0)7\d{3}\s?\d{6}$"
                title="Please enter a valid UK mobile number (e.g. 07XXX XXXXXX)"
                placeholder="07XXX XXXXXX"
                class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-fresh-green focus:ring-0 transition text-sm md:text-base text-gray-900"
              &gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;!-- Email (optional) --&gt;
          &lt;div&gt;
            &lt;label for="hq-email" class="block text-sm font-bold text-gray-700 mb-1.5"&gt;Email Address &lt;span class="text-gray-400 font-normal"&gt;(optional)&lt;/span&gt;&lt;/label&gt;
            &lt;input
              type="email"
              id="hq-email"
              name="email"
              autocomplete="email"
              inputmode="email"
              placeholder="john@example.com"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-fresh-green focus:ring-0 transition text-sm md:text-base text-gray-900"
            &gt;
          &lt;/div&gt;

          &lt;!-- Postcode (helps job sizing & travel time) --&gt;
          &lt;div&gt;
            &lt;label for="hq-postcode" class="block text-sm font-bold text-gray-700 mb-1.5"&gt;Postcode &lt;span class="text-gray-400 font-normal"&gt;(optional, speeds up your quote)&lt;/span&gt;&lt;/label&gt;
            &lt;input
              type="text"
              id="hq-postcode"
              name="postcode"
              autocomplete="postal-code"
              placeholder="NN1 1AA"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-fresh-green focus:ring-0 transition text-sm md:text-base text-gray-900 uppercase"
            &gt;
          &lt;/div&gt;

          &lt;!-- How did you hear about us (optional) --&gt;
          &lt;div&gt;
            &lt;label for="hq-referral-source" class="block text-sm font-bold text-gray-700 mb-1.5"&gt;How Did You Hear About Us? &lt;span class="text-gray-400 font-normal"&gt;(optional)&lt;/span&gt;&lt;/label&gt;
            &lt;select
              id="hq-referral-source"
              name="referral_source"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-fresh-green focus:ring-0 transition text-sm md:text-base text-gray-900"
            &gt;
              &lt;option value=""&gt;Please select...&lt;/option&gt;
              &lt;option value="Google"&gt;Google&lt;/option&gt;
              &lt;option value="Facebook"&gt;Facebook&lt;/option&gt;
              &lt;option value="Instagram"&gt;Instagram&lt;/option&gt;
              &lt;option value="Word of Mouth"&gt;Word of Mouth&lt;/option&gt;
              &lt;option value="Flyer / Leaflet"&gt;Flyer / Leaflet&lt;/option&gt;
              &lt;option value="Recommendation"&gt;Recommendation&lt;/option&gt;
              &lt;option value="Other"&gt;Other&lt;/option&gt;
            &lt;/select&gt;
          &lt;/div&gt;

          &lt;!-- Message --&gt;
          &lt;div&gt;
            &lt;label for="hq-message" class="block text-sm font-bold text-gray-700 mb-1.5"&gt;Tell us more &lt;span class="text-gray-400 font-normal"&gt;(optional)&lt;/span&gt;&lt;/label&gt;
            &lt;textarea
              id="hq-message"
              name="message"
              rows="3"
              placeholder="e.g. My garden is overgrown, roughly 20m x 10m, needs full clearance…"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-fresh-green focus:ring-0 transition resize-none text-sm md:text-base text-gray-900"
            &gt;&lt;/textarea&gt;
          &lt;/div&gt;

          &lt;!-- Submit --&gt;
          &lt;div&gt;
            &lt;button
              type="submit"
              id="hq-submit-btn"
              class="w-full bg-fresh-green text-white font-extrabold text-base md:text-lg py-3.5 rounded-xl hover:bg-deep-green transition-all shadow-lg hover:shadow-xl tracking-tight flex items-center justify-center gap-2"
            &gt;
              &lt;span id="hq-btn-text"&gt;Send My Free Quote — Reply within 2hrs ✓&lt;/span&gt;
              &lt;svg id="hq-spinner" class="hidden w-5 h-5 animate-spin text-white" fill="none" viewBox="0 0 24 24"&gt;
                &lt;circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"&gt;&lt;/circle&gt;
                &lt;path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z&quot;&gt;&lt;/path&gt;
              &lt;/svg&gt;
            &lt;/button&gt;
          &lt;/div&gt;

          &lt;!-- Alternative contact methods --&gt;
          &lt;div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1"&gt;
            &lt;a
              href={`tel:${siteConfig.phone}`}
              class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl border-2 border-deep-green text-deep-green font-bold text-sm hover:bg-deep-green hover:text-white transition"
            &gt;
              📞 Call {siteConfig.phoneFormatted}
            &lt;/a&gt;
            {siteConfig.whatsapp &amp;&amp; (
              &lt;a
                href={siteConfig.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-[#25D366] text-white font-bold text-sm hover:bg-[#1da851] transition"
              &gt;
                &lt;svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"&gt;&lt;path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>&lt;/svg&gt;
                Send via WhatsApp
              &lt;/a&gt;
            )}
          &lt;/div&gt;

          &lt;p class="text-center text-[11px] text-gray-400 mt-2"&gt;
            We'll only use your details to reply about your quote. No spam, ever.
          &lt;/p&gt;
        &lt;/form&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;style&gt;
  .service-btn.selected {
    border-color: theme('colors.fresh-green');
    background-color: theme('colors.bg-light');
  }
  .service-btn.selected span:last-child {
    color: theme('colors.deep-green');
    font-weight: 700;
  }
&lt;/style&gt;

&lt;script&gt;
  document.addEventListener('DOMContentLoaded', () =&gt; {
    const modal = document.getElementById('quote-modal');
    const backdrop = document.getElementById('quote-modal-backdrop');
    const closeBtn = document.getElementById('quote-modal-close');
    const buttons = document.querySelectorAll&lt;HTMLButtonElement&gt;('.service-btn');
    const hiddenInput = document.getElementById('homepage-service-value') as HTMLInputElement | null;
    const serviceError = document.getElementById('service-error');
    const form = document.getElementById('homepage-quote-form-el') as HTMLFormElement | null;
    const submitBtn = document.getElementById('hq-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('hq-btn-text');
    const spinner = document.getElementById('hq-spinner');

    let userClosedThisSession = false;

    function openModal() {
      if (!modal) return;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'open_quote_modal', { event_category: 'engagement' });
      }
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      userClosedThisSession = true;
      try { sessionStorage.setItem('quote_modal_dismissed', '1'); } catch {}
    }

    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);

    document.querySelectorAll('.quote-cta-btn').forEach(btn =&gt; {
      btn.addEventListener('click', openModal);
    });

    document.getElementById('hero-quote-btn')?.addEventListener('click', openModal);

    document.addEventListener('keydown', (e) =&gt; {
      if (e.key === 'Escape' &amp;&amp; modal &amp;&amp; !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    buttons.forEach(btn =&gt; {
      btn.addEventListener('click', () =&gt; {
        buttons.forEach(b =&gt; {
          b.classList.remove('selected');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('selected');
        btn.setAttribute('aria-pressed', 'true');
        if (hiddenInput) hiddenInput.value = btn.dataset.service || '';
        if (serviceError) serviceError.classList.add('hidden');
      });
    });

    form?.addEventListener('submit', (e) =&gt; {
      if (!hiddenInput?.value) {
        e.preventDefault();
        if (serviceError) serviceError.classList.remove('hidden');
        document.getElementById('service-buttons')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      if (btnText) btnText.textContent = 'Sending…';
      if (spinner) spinner.classList.remove('hidden');
      if (submitBtn) submitBtn.disabled = true;
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'generate_lead', {
          event_category: 'conversion',
          service: hiddenInput.value,
        });
      }
    });

    // Auto-open: homepage only, once per session, after 50% scroll OR 40s.
    // Skipped if user has already dismissed it this session.
    const isHomepage = window.location.pathname === '/' || window.location.pathname === '';
    let alreadyDismissed = false;
    try { alreadyDismissed = sessionStorage.getItem('quote_modal_dismissed') === '1'; } catch {}
    let alreadyAutoOpened = false;

    function maybeAutoOpen() {
      if (!isHomepage || alreadyAutoOpened || alreadyDismissed || userClosedThisSession) return;
      if (modal &amp;&amp; !modal.classList.contains('hidden')) return;
      alreadyAutoOpened = true;
      openModal();
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'auto_open_quote_modal', { event_category: 'engagement' });
      }
    }

    if (isHomepage &amp;&amp; !alreadyDismissed) {
      setTimeout(maybeAutoOpen, 40000);
      const onScroll = () =&gt; {
        const scrolled = window.scrollY + window.innerHeight;
        const total = document.documentElement.scrollHeight;
        if (total &gt; 0 &amp;&amp; scrolled / total &gt;= 0.5) {
          maybeAutoOpen();
          window.removeEventListener('scroll', onScroll);
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  });
&lt;/script&gt;