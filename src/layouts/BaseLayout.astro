---
import { siteConfig, services } from '../config';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import HomepageQuoteForm from '../components/HomepageQuoteForm.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
  image?: string;
}

const { title, description = siteConfig.description, canonical, noindex = false, schema, image } = Astro.props;
// Keep search titles concise; long, descriptive page titles do not need a second brand suffix.
const fullTitle = title === siteConfig.name || title.includes(siteConfig.name) || title.length > 52
  ? title
  : `${title} | ${siteConfig.name}`;
const metaDescription = description.length > 160
  ? `${description.slice(0, 157).replace(/\s+\S*$/, '')}...`
  : description;
const canonicalURL = canonical || new URL(Astro.url.pathname, siteConfig.baseUrl).toString();
const socialImage = new URL(image || siteConfig.ogImage.path, siteConfig.baseUrl).toString();
const allAreas = [...siteConfig.primaryAreas, ...siteConfig.secondaryAreas, ...siteConfig.extendedAreas];
// Clean page name for breadcrumbs: strip any branding suffix (e.g. "Page Title | Dee'z Gardens" → "Page Title")
const breadcrumbName = title.split(' | ')[0].trim();
// Validate GA4 ID format to prevent any script injection (must be G- followed by alphanumeric)
const gaId = siteConfig.googleAnalyticsId && /^G-[A-Z0-9]+$/.test(siteConfig.googleAnalyticsId)
  ? siteConfig.googleAnalyticsId
  : null;
// Build address object — only include streetAddress/postalCode when the owner has filled them in
const postalAddress: Record<string, string> = {
  "@type": "PostalAddress",
  "addressLocality": "Northampton",
  "addressRegion": "Northamptonshire",
  "addressCountry": "GB",
};
if (siteConfig.address.streetAddress) postalAddress["streetAddress"] = siteConfig.address.streetAddress;
if (siteConfig.address.postalCode) postalAddress["postalCode"] = siteConfig.address.postalCode;
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content={Astro.generator}>
  
  <!-- Google Analytics 4 — add your Measurement ID to src/config.ts (googleAnalyticsId) -->
  {gaId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`}></script>
    </>
  )}
  
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription}>
  <link rel="canonical" href={canonicalURL}>
  
  {noindex ? <meta name="robots" content="noindex, nofollow"> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">}
  
  <!-- Geo meta tags for local SEO -->
  <meta name="geo.region" content="GB-NTH">
  <meta name="geo.placename" content="Northampton">
  <meta name="geo.position" content="52.2405;-0.9027">
  <meta name="ICBM" content="52.2405, -0.9027">

  <!-- Tell mobile browsers our phone numbers ARE phone numbers (improves tap-to-call UX) -->
  <meta name="format-detection" content="telephone=yes">
  <!-- Hint Google we're UK English -->
  <meta http-equiv="Content-Language" content="en-GB">
  
  <!-- Theme color -->
  <meta name="theme-color" content="#16a34a">
  <meta name="author" content="Dee'z Gardens">
  <link rel="sitemap" href="/sitemap-index.xml">
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={metaDescription}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:site_name" content={siteConfig.name}>
  <meta property="og:locale" content="en_GB">
  <meta property="og:image" content={socialImage}>
  <meta property="og:image:width" content={String(siteConfig.ogImage.width)}>
  <meta property="og:image:height" content={String(siteConfig.ogImage.height)}>
  <meta property="og:image:type" content={siteConfig.ogImage.type}>
  <meta property="og:image:alt" content={`${siteConfig.name} landscaping and garden transformations in Northampton`}>
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={metaDescription}>
  <meta name="twitter:image" content={socialImage}>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png">
  
  <!-- Schema.org JSON-LD - LocalBusiness -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
    "@id": siteConfig.baseUrl,
    "name": siteConfig.name,
    "description": siteConfig.description,
    "url": siteConfig.baseUrl,
    "telephone": siteConfig.phone,
    "email": siteConfig.email,
    "image": socialImage,
    "logo": `${siteConfig.baseUrl}/favicon.svg`,
    "address": postalAddress,
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 52.2405,
      "longitude": -0.9027
    },
    "areaServed": allAreas.map(area => ({
      "@type": "City",
      "name": area
    })),
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Garden & Property Services",
      "itemListElement": services.map(service => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": service.title,
          "description": service.description
        }
      }))
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    "sameAs": [siteConfig.facebook, siteConfig.googleBusinessProfile].filter(Boolean),
    "priceRange": "££",
    "paymentAccepted": "Cash, Credit Card, Apple Pay",
    "currenciesAccepted": "GBP",
    "knowsLanguage": "en"
  })} />

  <!-- WebSite identity schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteConfig.baseUrl}/#website`,
    "name": siteConfig.name,
    "url": siteConfig.baseUrl
  })} />

  <!-- Current-page entity and its primary project image -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${canonicalURL}#webpage`,
    "url": canonicalURL,
    "name": fullTitle,
    "description": metaDescription,
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "contentUrl": socialImage
    },
    "isPartOf": { "@id": `${siteConfig.baseUrl}/#website` }
  })} />

  <!-- Page-specific schema -->
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

  <!-- BreadcrumbList schema for richer search results -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": Astro.url.pathname === '/' ? [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteConfig.baseUrl }
    ] : [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteConfig.baseUrl },
      { "@type": "ListItem", "position": 2, "name": breadcrumbName, "item": canonicalURL }
    ]
  })} />
</head>
<body>
  <slot name="header" />
  <main>
    <slot />
  </main>
  <slot name="footer" />
  <StickyMobileCTA />
  <HomepageQuoteForm />

  <!-- Lead-intent click tracking: pushes events to dataLayer so they're captured the moment GA4/GTM is wired up -->
  <script is:inline>
    (function () {
      window.dataLayer = window.dataLayer || [];
      function track(name, data) {
        try { window.dataLayer.push(Object.assign({ event: name }, data || {})); } catch (e) {}
      }
      document.addEventListener('click', function (e) {
        var el = e.target instanceof Element ? e.target.closest('a,button') : null;
        if (!el) return;
        var href = el.getAttribute('href') || '';
        if (href.indexOf('tel:') === 0) {
          track('phone_click', { phone: href.replace('tel:', ''), location: window.location.pathname });
        } else if (href.indexOf('mailto:') === 0) {
          track('email_click', { location: window.location.pathname });
        } else if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp') !== -1) {
          track('whatsapp_click', { location: window.location.pathname });
        }
      }, { passive: true });
    })();
  </script>
</body>
</html>
