---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import QuickQuoteBand from '../../components/QuickQuoteBand.astro';
import { landscapingProjects } from '../../data/projects';
---
<BaseLayout title="Landscaping Projects | Dee'z Gardens Northampton" description="See real Dee'z Gardens landscaping projects: patios, steps, lawns and garden makeovers. Matched before-and-after photos with details of the work.">
  <Header slot="header" />
  <section class="bg-deep-green text-white py-12"><div class="container mx-auto px-4 max-w-4xl text-center"><h1 class="text-3xl md:text-5xl text-white font-extrabold">Our landscaping projects</h1><p class="mt-4">Matched before-and-after photographs from our own work. See the starting garden, the finished layout and the features installed.</p></div></section>
  <section class="py-10 bg-bg-sage"><div class="container mx-auto px-4 max-w-6xl grid md:grid-cols-3 gap-6">{landscapingProjects.map(project=><a href={`/projects/${project.slug}/`} class="bg-white shadow-lg rounded-2xl overflow-hidden group"><img src={`/assets/images/projects-2026/${project.after}`} alt={project.afterAlt} width="900" height="1200" loading="lazy" class="aspect-[4/3] w-full object-cover" /><div class="p-6"><h2 class="text-xl font-bold text-deep-green mb-3">{project.title}</h2><p class="text-gray-700 mb-4">{project.summary}</p><span class="font-bold text-fresh-green group-hover:underline">View the project and before photos →</span></div></a>)}</div></section>
  <QuickQuoteBand service="a similar garden transformation" />
  <Footer slot="footer" />
</BaseLayout>
