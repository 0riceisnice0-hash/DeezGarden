---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import QuickQuoteBand from '../components/QuickQuoteBand.astro';
import ProjectServices from '../components/ProjectServices.astro';
import ProjectPlanning, { projectQuestions } from '../components/ProjectPlanning.astro';
import AreasCompact from '../components/AreasCompact.astro';
import { siteConfig } from '../config';
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:projectQuestions.map(q=>({'@type':'Question',name:q.question,acceptedAnswer:{'@type':'Answer',text:q.answer}}))};
---
<BaseLayout title="Landscapers Northampton | Patios & Garden Makeovers" description="Landscaping in Northampton: patios, paving, turf, artificial lawns and complete garden makeovers. See real before-and-after work. Free project quotes." image="/assets/images/projects-2026/family-garden-turf-gravel-after.webp" schema={schema}>
  <Header slot="header" />
  <Hero title="Landscaping & Garden Makeovers in Northampton" subtitle="Patios, paving, new lawns and complete garden transformations" heroImage="projects-2026/family-garden-turf-gravel-after.webp" showQuoteButton={true} />
  <TrustBadges />
  <QuickQuoteBand service="your landscaping project" />
  <section class="py-6 bg-white"><div class="container mx-auto px-4 max-w-4xl text-center"><p class="text-lg font-semibold text-deep-green">A new patio. A better lawn. A garden you can use.</p><p class="text-gray-700">We take on landscaping installations, garden renovations and one-off clearance projects. Every job is quoted for the agreed work. Hourly gardening and regular mowing are not offered.</p></div></section>
  <ProjectServices />
  <ProjectShowcase heading="See our completed landscaping projects" />
  <section class="py-8 md:py-14 bg-bg-light"><div class="container mx-auto px-4 max-w-6xl grid lg:grid-cols-2 items-center gap-8">
    <div><h2 class="text-2xl md:text-3xl font-extrabold mb-4">One team from clearance to the finished garden</h2><p class="text-gray-700 mb-4">{siteConfig.name} works across Northampton and surrounding Northamptonshire towns. We can clear the old garden, prepare the ground and install the paving, turf, gravel, timber edging and steps included in your project.</p><p class="text-gray-700 mb-4">Your quote starts with the space you have and the result you want. Tell us about access, garden levels and the materials you like, and we will discuss the practical options.</p><a href="/services/landscaping/" class="font-bold text-deep-green underline">Explore our landscaping service</a></div>
    <BeforeAfterSlider beforeImage="renovation1.jpg" afterImage="renovation1-after.jpg" beforeAlt="Garden before renovation" afterAlt="Garden after renovation" />
  </div></section>
  <ReviewsCarousel />
  <ProjectPlanning />
  <section class="py-8 bg-bg-sage"><div class="container mx-auto px-4 text-center max-w-5xl"><h2 class="text-2xl font-bold mb-3">Landscaping across Northamptonshire</h2><p class="text-gray-700 mb-5">Based in Northampton, serving Daventry, Wellingborough, Kettering, Rushden, Towcester, Brackley and surrounding towns. Send your postcode to confirm availability for your project.</p><AreasCompact /><div class="hidden md:flex flex-wrap justify-center gap-3">{[...siteConfig.primaryAreas,...siteConfig.secondaryAreas].map(area=><a href={`/areas/${area.toLowerCase().replace(/ /g,'-')}/`} class="bg-white rounded-lg px-4 py-2 font-bold text-deep-green">{area}</a>)}</div></div></section>
  <QuickQuoteBand service="a patio, new lawn or garden makeover" />
  <Footer slot="footer" />
</BaseLayout>
