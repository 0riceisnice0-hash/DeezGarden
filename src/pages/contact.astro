---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import HeroCTA from '../components/HeroCTA.astro';
import SlideOutQuoteForm from '../components/SlideOutQuoteForm.astro';
import { siteConfig } from '../config';
---

<BaseLayout 
  title="Contact Us | Free Garden & Clearance Quotes Northampton"
  description="Contact Dee'z Gardens for a free quote on garden maintenance, landscaping, rubbish clearance or man with van services in Northampton & Northamptonshire. Call 07305 195098 or email us today."
>
  <Header slot="header" />
  
  <SlideOutQuoteForm />
  
  <Hero 
    heroImage="chainsaw.jpg"
    title="Contact Us"
    subtitle="Get a free, no-obligation quote"
    showQuoteButton={true}
  />
  
  <TrustBadges />
  
  <section class="py-6 md:py-16 bg-bg-light">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-12">
          <!-- Contact Information -->
          <div class="order-2 md:order-1">
            <h2 class="text-lg md:text-2xl font-bold mb-3 md:mb-6">Get in Touch</h2>
            <p class="mb-4 md:mb-8 text-sm md:text-lg">
              We'd love to hear from you! Get in touch using any of the methods below.
            </p>
            
            <div class="space-y-3 md:space-y-6">
              <div class="flex items-start space-x-3">
                <div class="w-7 h-7 md:w-8 md:h-8 bg-fresh-green rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 text-xs md:text-sm">P</div>
                <div>
                  <h3 class="font-bold text-sm md:text-lg mb-0.5">Phone</h3>
                  <p class="text-gray-700 mb-1 text-xs md:text-sm">Our preferred contact method</p>
                  <a 
                    href={`tel:${siteConfig.phone}`}
                    class="text-base md:text-xl font-bold text-fresh-green hover:text-deep-green"
                  >
                    {siteConfig.phoneFormatted}
                  </a>
                </div>
              </div>
              
              <div class="flex items-start space-x-3">
                <div class="w-7 h-7 md:w-8 md:h-8 bg-fresh-green rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 text-xs md:text-sm">E</div>
                <div>
                  <h3 class="font-bold text-sm md:text-lg mb-0.5">Email</h3>
                  <a 
                    href={`mailto:${siteConfig.email}`}
                    class="text-fresh-green hover:text-deep-green break-all text-xs md:text-base"
                  >
                    {siteConfig.email}
                  </a>
                </div>
              </div>
              
              {siteConfig.facebook && (
                <div class="flex items-start space-x-3">
                  <div class="w-7 h-7 md:w-8 md:h-8 bg-fresh-green rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 text-xs md:text-sm">F</div>
                  <div>
                    <h3 class="font-bold text-sm md:text-lg mb-0.5">Facebook</h3>
                    <a 
                      href={siteConfig.facebook}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-fresh-green hover:text-deep-green text-xs md:text-base"
                    >
                      Join our Facebook group
                    </a>
                  </div>
                </div>
              )}

              {siteConfig.googleBusinessProfile && (
                <div class="flex items-start space-x-3">
                  <div class="w-7 h-7 md:w-8 md:h-8 bg-yellow-400 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 text-xs md:text-sm">★</div>
                  <div>
                    <h3 class="font-bold text-sm md:text-lg mb-0.5">Google</h3>
                    <a 
                      href={siteConfig.googleBusinessProfile}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-fresh-green hover:text-deep-green text-xs md:text-base"
                    >
                      View us on Google &amp; leave a review
                    </a>
                  </div>
                </div>
              )}
              
              {siteConfig.whatsapp && (
                <div class="flex items-start space-x-3">
                  <div class="w-7 h-7 md:w-8 md:h-8 bg-[#25D366] rounded-full flex items-center justify-center text-white flex-shrink-0">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-sm md:text-lg mb-0.5">WhatsApp</h3>
                    <a 
                      href={siteConfig.whatsapp}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[#25D366] hover:text-[#1da851] font-semibold text-xs md:text-base"
                    >
                      Message us on WhatsApp
                    </a>
                  </div>
                </div>
              )}
              
              <div class="flex items-start space-x-3">
                <div>
                  <h3 class="font-bold text-sm md:text-lg mb-0.5">Service Area</h3>
                  <p class="text-gray-700 text-xs md:text-sm">{siteConfig.location}</p>
                  <a 
                    href="/areas/"
                    class="text-fresh-green hover:text-deep-green text-xs md:text-sm"
                  >
                    View all areas we cover →
                  </a>
                </div>
              </div>
            </div>
            
            <div class="mt-4 md:mt-8 bg-bg-light p-3 md:p-6 rounded-lg">
              <h3 class="font-bold text-sm md:text-lg mb-1 md:mb-3">Opening Hours</h3>
              <p class="text-gray-700 text-xs md:text-base">Monday - Saturday: 8:00 AM - 6:00 PM</p>
              <p class="text-gray-700 text-xs md:text-sm mt-1">Sunday: Closed</p>
            </div>
          </div>
          
          <!-- Contact Form -->
          <div class="order-1 md:order-2">
            <h2 class="text-lg md:text-2xl font-bold mb-3 md:mb-6">Get a Free Quote</h2>

            <!-- Risk reversal / promise strip -->
            <ul class="grid grid-cols-2 gap-2 mb-4 text-xs md:text-sm">
              <li class="flex items-center gap-1.5 bg-bg-light rounded-lg px-3 py-2"><span class="text-fresh-green font-bold">✓</span> Free, no-obligation</li>
              <li class="flex items-center gap-1.5 bg-bg-light rounded-lg px-3 py-2"><span class="text-fresh-green font-bold">✓</span> Friendly local team</li>
              <li class="flex items-center gap-1.5 bg-bg-light rounded-lg px-3 py-2"><span class="text-fresh-green font-bold">✓</span> Fully insured</li>
              <li class="flex items-center gap-1.5 bg-bg-light rounded-lg px-3 py-2"><span class="text-fresh-green font-bold">✓</span> Licensed waste carrier</li>
            </ul>

            <form 
              action="https://formspree.io/f/mdalolve"
              method="POST"
              id="contact-quote-form"
              class="space-y-3 md:space-y-4"
            >
              <input type="hidden" name="_next" value={`${siteConfig.baseUrl}/thank-you/`}>
              <input type="hidden" name="_subject" value="New quote request from Dee'z Gardens website">
              <input type="hidden" name="landing_page" id="contact-landing-page">
              <div>
                <label for="name" class="block font-semibold mb-1 md:mb-2 text-xs md:text-base">Your Name *</label>
                <input 
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-3 py-2.5 md:py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-fresh-green text-sm md:text-base text-gray-900"
                  placeholder="John Smith"
                >
              </div>
              
              <div>
                <label for="email" class="block font-semibold mb-1 md:mb-2 text-xs md:text-base">Your Email <span class="text-gray-400 font-normal">(optional)</span></label>
                <input 
                  type="email"
                  id="email"
                  name="email"
                  autocomplete="email"
                  class="w-full px-3 py-2.5 md:py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-fresh-green text-sm md:text-base text-gray-900"
                  placeholder="john@example.com"
                >
              </div>
              
              <div>
                <label for="phone" class="block font-semibold mb-1 md:mb-2 text-xs md:text-base">Your Phone *</label>
                <input 
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  pattern="^[0-9+() -]{7,20}$"
                  title="Please enter a valid phone number"
                  class="w-full px-3 py-2.5 md:py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-fresh-green text-sm md:text-base text-gray-900"
                  placeholder="07XXX XXXXXX"
                >
              </div>
              
              <div>
                <label for="service" class="block font-semibold mb-1 md:mb-2 text-xs md:text-base">Service Required</label>
                <select 
                  id="service"
                  name="service"
                  class="w-full px-3 py-2.5 md:py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-fresh-green text-sm md:text-base text-gray-900"
                >
                  <option value="">Please select...</option>
                  <option value="Garden Maintenance">Garden Maintenance</option>
                  <option value="Garden Renovation">Garden Renovation</option>
                  <option value="Hedge Cutting">Hedge Cutting</option>
                  <option value="Garden Clearance">Garden Clearance</option>
                  <option value="Landscaping">Landscaping</option>
                  <option value="Rubbish Clearance">Rubbish Clearance</option>
                  <option value="Man with Van">Man with Van</option>
                  <option value="Property Maintenance">Property Maintenance</option>
                  <option value="Scrap Metal">Scrap Metal Collection</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div>
                <label for="referral-source" class="block font-semibold mb-1 md:mb-2 text-xs md:text-base">How Did You Hear About Us? <span class="text-gray-400 font-normal">(optional)</span></label>
                <select
                  id="referral-source"
                  name="referral_source"
                  class="w-full px-3 py-2.5 md:py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-fresh-green text-sm md:text-base text-gray-900"
                >
                  <option value="">Please select...</option>
                  <option value="Google">Google</option>
                  <option value="Facebook">Facebook</option>
                  <option value="Instagram">Instagram</option>
                  <option value="Word of Mouth">Word of Mouth</option>
                  <option value="Flyer / Leaflet">Flyer / Leaflet</option>
                  <option value="Recommendation">Recommendation</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              
              <div>
                <label for="message" class="block font-semibold mb-1 md:mb-2 text-xs md:text-base">Tell us about the job <span class="text-gray-400 font-normal">(optional)</span></label>
                <textarea 
                  id="message"
                  name="message"
                  rows="3"
                  class="w-full px-3 py-2.5 md:py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-fresh-green text-sm md:text-base text-gray-900"
                  placeholder="e.g. Garden roughly 20m x 10m, needs full clearance and a tidy lawn cut..."
                ></textarea>
              </div>
              
              <button 
                type="submit"
                class="w-full bg-fresh-green text-white px-6 py-2.5 md:py-4 rounded-lg font-extrabold text-sm md:text-lg hover:bg-deep-green transition shadow-lg hover:shadow-xl"
              >
                Get My Free Quote ✓
              </button>
              
              <p class="text-xs md:text-sm text-gray-600 text-center">
                Or call us directly on <a href={`tel:${siteConfig.phone}`} class="text-fresh-green font-semibold">{siteConfig.phoneFormatted}</a>
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <HeroCTA />
  
  <Footer slot="footer" />

  <script>
    const contactForm = document.getElementById('contact-quote-form');
    const contactLandingPage = document.getElementById('contact-landing-page') as HTMLInputElement | null;
    if (contactLandingPage) contactLandingPage.value = window.location.href;
    contactForm?.addEventListener('submit', () => {
      try { (window as any).dataLayer?.push({ event: 'generate_lead', source: 'contact_page' }); } catch {}
    });
  </script>
</BaseLayout>
