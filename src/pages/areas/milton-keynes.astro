---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import CallToAction from '../../components/CallToAction.astro';
import HeroCTA from '../../components/HeroCTA.astro';
import { siteConfig, services } from '../../config';

const areaName = "Milton Keynes";
const nearbyAreas = ["Bedford", "Northampton", "Aylesbury", "Buckingham"];
---

<BaseLayout 
  title={`Garden Clearance & Services ${areaName} | Leylandii Cutting, Garden Clearance, Landscaping`}
  description={`Garden clearance, Leylandii cutting, landscaping & rubbish removal in ${areaName}, Buckinghamshire. Serving Willen, Emerson Valley, Furzton, Shenley Brook End & surrounding grid squares. Fully insured, licensed waste carrier. Free quotes - call 07305 195098.`}
>
  <Header slot="header" />
  
  <Hero 
    title={`Garden Clearance & Services in ${areaName}`}
    location={`${areaName}, Buckinghamshire`}
    subtitle="Leylandii reduction, garden clearance, landscaping & rubbish removal"
    heroImage="hero.jpg"
  />
  
  <TrustBadges />
  
  <!-- Introduction Section -->
  <section class="py-4 md:py-16 bg-bg-light">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-xl md:text-3xl font-bold mb-3 md:mb-6">Garden Services in {areaName}</h2>
        <p class="text-sm md:text-lg mb-2 md:mb-4">
          {siteConfig.name} serves {areaName} and its many distinct residential grid squares — including Willen, Shenley Brook End, Emerson Valley, Furzton, Walton and beyond — from our Northampton base, just 20 miles north. {areaName}'s unique layout means properties from the 1970s through to the 1990s now have gardens where the original planting has long since matured and, in many cases, significantly outgrown its space. Leylandii and conifer hedges, planted in great numbers during the city's development for privacy along the grid roads, are now a leading source of garden work across the city.
        </p>
        <p class="text-sm md:text-lg">
          From major Leylandii reductions to full garden clearances of overgrown 1980s plots, or new landscaping on more recent {areaName} developments, our licensed team delivers reliable, professional results with all waste removed and disposed of legally. No skips or permits needed.
        </p>
      </div>
    </div>
  </section>

  <!-- Milton Keynes-Specific Services Section -->
  <section class="py-4 md:py-16 bg-bg-sage border-b-2 border-fresh-green/20">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-lg md:text-2xl font-extrabold text-center mb-6 md:mb-10 tracking-tight">Our Key Services in {areaName}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
          <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-fresh-green">
            <h3 class="text-base md:text-lg font-bold text-deep-green mb-2">Leylandii Cutting & Reduction {areaName}</h3>
            <p class="text-sm md:text-base text-gray-700 mb-3">Leylandii is ubiquitous across {areaName}'s residential grid squares — planted for privacy in the 1970s and 80s, many now reach 20–30 feet or more. We safely reduce and reshape overgrown Leylandii and conifers across Emerson Valley, Furzton, Walton and throughout the city, restoring them to a manageable size.</p>
            <a href="/services/hedge-cutting/" class="text-fresh-green font-semibold hover:text-deep-green text-sm">Learn more →</a>
          </div>
          <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-deep-green">
            <h3 class="text-base md:text-lg font-bold text-deep-green mb-2">Garden Clearance {areaName}</h3>
            <p class="text-sm md:text-base text-gray-700 mb-3">Gardens in {areaName}'s 1970s and 80s grid squares often contain decades of accumulated planting that has outgrown its original design. We clear overgrown shrub beds, bramble patches, old structures and garden waste across all grid squares, leaving a clean slate for whatever comes next.</p>
            <a href="/services/garden-clearance/" class="text-fresh-green font-semibold hover:text-deep-green text-sm">Learn more →</a>
          </div>
          <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-fresh-green">
            <h3 class="text-base md:text-lg font-bold text-deep-green mb-2">Rubbish Removal {areaName}</h3>
            <p class="text-sm md:text-base text-gray-700 mb-3">Our licensed man-and-van service is ideal for {areaName} residents needing quick, straightforward waste removal. Garden waste, old furniture, garage contents or general household rubbish — we load and remove it all from your {areaName} grid square property without the need for a skip or council booking.</p>
            <a href="/services/man-with-van/" class="text-fresh-green font-semibold hover:text-deep-green text-sm">Learn more →</a>
          </div>
          <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-deep-green">
            <h3 class="text-base md:text-lg font-bold text-deep-green mb-2">Landscaping {areaName}</h3>
            <p class="text-sm md:text-base text-gray-700 mb-3">Following a clearance or on a newer {areaName} development, we design and build complete gardens tailored to your space and lifestyle. Lawns, patios, raised borders and planting schemes — our landscaping service transforms {areaName} outdoor spaces in grid squares like Willen, Shenley Brook End and beyond.</p>
            <a href="/services/landscaping/" class="text-fresh-green font-semibold hover:text-deep-green text-sm">Learn more →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Services Section -->
  <section class="py-4 md:py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <h3 class="text-lg md:text-2xl font-bold mb-4 md:mb-8 text-center">Our Services in {areaName}</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
          {services.map((service, index) => {
            const images = [
              "/assets/images/before-and-after-lawn-1.jpg",
              "/assets/images/rubbish-removal-1.jpg",
              "/assets/images/van-scrap.png"
            ];
            return (
              <div class="bg-bg-light rounded-xl overflow-hidden shadow-md hover:shadow-lg transition flex flex-col h-full">
                <div class="h-32 md:h-48 overflow-hidden flex-shrink-0">
                  <img 
                    src={images[index]}
                    loading="lazy"
                    alt={service.title}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="p-4 md:p-6 flex flex-col flex-grow">
                  <h4 class="font-bold text-base md:text-lg mb-2 text-deep-green min-h-[2.5rem] md:min-h-[3rem]">{service.title}</h4>
                  <p class="text-xs md:text-sm text-gray-700 mb-3 flex-grow">{service.description}</p>
                  <a 
                    href={`/services/${service.slug}/`}
                    class="inline-block bg-fresh-green text-white px-4 py-2 rounded-lg font-semibold text-sm hover:bg-deep-green transition w-full text-center mt-auto"
                  >
                    Learn More
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>
  
  <CallToAction />
  
  <!-- Why Choose Us Section -->
  <section class="py-4 md:py-16 bg-gradient-to-b from-white to-light-green/5">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-lg md:text-3xl font-bold mb-4 md:mb-8 text-center">Why Choose {siteConfig.name} in {areaName}?</h2>
        
        <p class="text-sm md:text-lg text-center mb-4 md:mb-8">
          We're proud to extend our services to {areaName}, offering the same high standards we provide in Northampton and throughout the region.
        </p>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-6">
          <div class="bg-white rounded-lg p-3 md:p-6 shadow-sm border border-gray-100 text-center">
            <div class="text-2xl md:text-3xl mb-2">🛡️</div>
            <h4 class="font-bold text-sm md:text-base text-deep-green mb-1">Fully Insured</h4>
            <p class="text-xs md:text-sm text-gray-600">Complete peace of mind</p>
          </div>
          <div class="bg-white rounded-lg p-3 md:p-6 shadow-sm border border-gray-100 text-center">
            <div class="text-2xl md:text-3xl mb-2">📋</div>
            <h4 class="font-bold text-sm md:text-base text-deep-green mb-1">Licensed Carrier</h4>
            <p class="text-xs md:text-sm text-gray-600">Legal waste disposal</p>
          </div>
          <div class="bg-white rounded-lg p-3 md:p-6 shadow-sm border border-gray-100 text-center">
            <div class="text-2xl md:text-3xl mb-2">⭐</div>
            <h4 class="font-bold text-sm md:text-base text-deep-green mb-1">Professional</h4>
            <p class="text-xs md:text-sm text-gray-600">Quality workmanship</p>
          </div>
          <div class="bg-white rounded-lg p-3 md:p-6 shadow-sm border border-gray-100 text-center">
            <div class="text-2xl md:text-3xl mb-2">💰</div>
            <h4 class="font-bold text-sm md:text-base text-deep-green mb-1">Fair Pricing</h4>
            <p class="text-xs md:text-sm text-gray-600">No hidden fees</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <CallToAction text={`Get Your Free ${areaName} Quote`} />
  
  <!-- Nearby Areas Section -->
  <section class="py-4 md:py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-lg md:text-3xl font-bold mb-4 md:mb-6">Nearby Areas We Also Serve</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
          {nearbyAreas.map((nearbyArea: string) => (
            <a 
              href={`/areas/${nearbyArea.toLowerCase().replace(/ /g, '-')}/`}
              class="bg-bg-light p-3 md:p-4 rounded-lg hover:bg-fresh-green hover:text-white transition font-semibold text-sm md:text-base"
            >
              {nearbyArea}
            </a>
          ))}
        </div>
        <div class="mt-4 md:mt-6">
          <a href="/areas/" class="text-fresh-green font-semibold hover:text-deep-green text-sm md:text-base">
            View all areas →
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <HeroCTA />
  
  <Footer slot="footer" />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `${siteConfig.name} - ${areaName}`,
  "description": `Professional Leylandii cutting, garden clearance, landscaping and rubbish removal in ${areaName}, Buckinghamshire. Serving Willen, Emerson Valley, Furzton, Shenley Brook End and surrounding grid squares. Fully insured, licensed waste carrier.`,
  "url": `${siteConfig.baseUrl}/areas/${areaName.toLowerCase().replace(/ /g, '-')}/`,
  "telephone": siteConfig.phone,
  "email": siteConfig.email,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": areaName,
    "addressRegion": "Buckinghamshire",
    "addressCountry": "GB"
  },
  "areaServed": {
    "@type": "City",
    "name": areaName
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": `Services in ${areaName}`,
    "itemListElement": services.map(service => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": service.title,
        "description": service.description
      }
    }))
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "opens": "08:00",
    "closes": "18:00"
  },
  "priceRange": "££"
})} />
