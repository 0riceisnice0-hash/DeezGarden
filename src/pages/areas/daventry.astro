---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import ProjectServices from '../../components/ProjectServices.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import CallToAction from '../../components/CallToAction.astro';
import HeroCTA from '../../components/HeroCTA.astro';
import SlideOutQuoteForm from '../../components/SlideOutQuoteForm.astro';
import { siteConfig, services } from '../../config';

const areaName = "Daventry";
const nearbyAreas = ["Northampton", "Rugby", "Brackley", "Towcester"];
---

<BaseLayout 
  title={`Landscaping ${areaName} | Patios & Garden Makeovers`}
  description={`Landscaping in ${areaName}: patios, paving, turf, artificial lawns and full garden makeovers. See our work and request a free project quote.`}
>
  <Header slot="header" />
  
  <SlideOutQuoteForm />
  
  <Hero 
    title={`Landscaping & Garden Makeovers in ${areaName}`}
    location={`${areaName}, West Northamptonshire`}
    subtitle="Patios, paving, new lawns and quoted garden renovation projects"
    heroImage="projects-2026/family-garden-turf-gravel-after.webp"
  />
  
  <TrustBadges />
  <ProjectServices />
  <section class="py-5 bg-white"><div class="container mx-auto px-4 max-w-4xl text-center"><p class="font-semibold text-deep-green">Landscaping installations and one-off jobs quoted for the agreed work. Hourly gardening and regular mowing are not offered.</p></div></section>
  
  <!-- Introduction Section -->
  <section class="py-4 md:py-16 bg-bg-light">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-xl md:text-3xl font-bold mb-3 md:mb-6">Garden Services in {areaName}</h2>
        <p class="text-sm md:text-lg mb-2 md:mb-4">
          {siteConfig.name} provides professional garden and property services throughout {areaName} and its surrounding villages. Situated around 12 miles west of Northampton, Daventry is a market town with a wide mix of properties — from Victorian and Edwardian terraces near the town centre to newer housing estates at Monksmoor and Middlemore. Many older properties close to {areaName} Country Park and the reservoir boast mature gardens with established hedgerows that benefit from a considered renovation.
        </p>
        <p class="text-sm md:text-lg">
          Whether you need overgrown boundary hedges cut back, a mature garden cleared, or a brand-new garden on a Monksmoor estate landscaped from scratch, our experienced team delivers reliable results throughout {areaName} and the surrounding rural villages.
        </p>
      </div>
    </div>
  </section>

  <!-- Daventry-Specific Services Section -->
  <section class="py-4 md:py-16 bg-bg-sage border-b-2 border-fresh-green/20">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-lg md:text-2xl font-extrabold text-center mb-6 md:mb-10 tracking-tight">Our Key Services in {areaName}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
          <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-fresh-green">
            <h3 class="text-base md:text-lg font-bold text-deep-green mb-2">Hedge Cutting {areaName}</h3>
            <p class="text-sm md:text-base text-gray-700 mb-3">We quote for garden renovation and installation work in {areaName}, including new patios, lawns, gravel, paths and timber edging. Send photos, approximate measurements and access details so we can discuss the scope of your project.</p>
            <a href="/services/hedge-cutting/" class="text-fresh-green font-semibold hover:text-deep-green text-sm">Learn more →</a>
          </div>
          <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-deep-green">
            <h3 class="text-base md:text-lg font-bold text-deep-green mb-2">Garden Clearance {areaName}</h3>
            <p class="text-sm md:text-base text-gray-700 mb-3">Mature gardens in {areaName}'s older streets and villages can become heavily overgrown over the years. We carry out thorough garden clearances — removing brambles, scrub, old shrubs and garden waste — leaving the space clean and manageable.</p>
            <a href="/services/garden-clearance/" class="text-fresh-green font-semibold hover:text-deep-green text-sm">Learn more →</a>
          </div>
          <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-fresh-green">
            <h3 class="text-base md:text-lg font-bold text-deep-green mb-2">Landscaping {areaName}</h3>
            <p class="text-sm md:text-base text-gray-700 mb-3">New-build homes on estates like Monksmoor and Middlemore often come with bare, unfinished plots. We help {areaName} homeowners design and create lawns, borders, paths and patios — transforming empty spaces into usable gardens.</p>
            <a href="/services/landscaping/" class="text-fresh-green font-semibold hover:text-deep-green text-sm">Learn more →</a>
          </div>
          <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-deep-green">
            <h3 class="text-base md:text-lg font-bold text-deep-green mb-2">Rubbish Removal {areaName}</h3>
            <p class="text-sm md:text-base text-gray-700 mb-3">From old garden furniture and broken sheds to general household waste, our licensed man-and-van service collects and removes rubbish from {areaName} properties quickly and at a fair price — no skips, no hassle.</p>
            <a href="/services/man-with-van/" class="text-fresh-green font-semibold hover:text-deep-green text-sm">Learn more →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Services Section -->
  <section class="py-4 md:py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <h3 class="text-lg md:text-2xl font-bold mb-4 md:mb-8 text-center">Our Services in {areaName}</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
          {services.map((service) => {
            return (
              <div class="bg-bg-light rounded-xl overflow-hidden shadow-md hover:shadow-lg transition flex flex-col h-full">
                <div class="h-32 md:h-48 overflow-hidden flex-shrink-0">
                  <img 
                    src={service.slug === "landscaping" ? "/assets/images/projects-2026/family-garden-turf-gravel-after.webp" : service.slug === "garden-renovations" ? "/assets/images/projects-2026/artificial-lawn-patio-after.webp" : "/assets/images/projects-2026/garden-clearance-before.webp"}
                    loading="lazy"
                    alt={service.title}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="p-4 md:p-6 flex flex-col flex-grow">
                  <h4 class="font-bold text-base md:text-lg mb-2 text-deep-green min-h-[2.5rem] md:min-h-[3rem]">{service.title}</h4>
                  <p class="text-xs md:text-sm text-gray-700 mb-3 flex-grow">{service.description}</p>
                  <a 
                    href={`/services/${service.slug}/`}
                    class="inline-block bg-fresh-green text-white px-4 py-2 rounded-lg font-semibold text-sm hover:bg-deep-green transition w-full text-center mt-auto"
                  >
                    Learn More
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>
  
  <CallToAction />
  
  <!-- Why Choose Us Section -->
  <section class="py-4 md:py-16 bg-gradient-to-b from-white to-light-green/5">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-lg md:text-3xl font-bold mb-4 md:mb-8 text-center">Why Choose {siteConfig.name} in {areaName}?</h2>
        
        <p class="text-sm md:text-lg text-center mb-4 md:mb-8">
          We're proud to extend our services to {areaName}, offering the same high standards we provide in Northampton and throughout the region.
        </p>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-6">
          <div class="bg-white rounded-lg p-3 md:p-6 shadow-sm border border-gray-100 text-center">
            <div class="text-2xl md:text-3xl mb-2">🛡️</div>
            <h4 class="font-bold text-sm md:text-base text-deep-green mb-1">Fully Insured</h4>
            <p class="text-xs md:text-sm text-gray-600">Complete peace of mind</p>
          </div>
          <div class="bg-white rounded-lg p-3 md:p-6 shadow-sm border border-gray-100 text-center">
            <div class="text-2xl md:text-3xl mb-2">📋</div>
            <h4 class="font-bold text-sm md:text-base text-deep-green mb-1">Licensed Carrier</h4>
            <p class="text-xs md:text-sm text-gray-600">Legal waste disposal</p>
          </div>
          <div class="bg-white rounded-lg p-3 md:p-6 shadow-sm border border-gray-100 text-center">
            <div class="text-2xl md:text-3xl mb-2">⭐</div>
            <h4 class="font-bold text-sm md:text-base text-deep-green mb-1">Professional</h4>
            <p class="text-xs md:text-sm text-gray-600">Quality workmanship</p>
          </div>
          <div class="bg-white rounded-lg p-3 md:p-6 shadow-sm border border-gray-100 text-center">
            <div class="text-2xl md:text-3xl mb-2">💰</div>
            <h4 class="font-bold text-sm md:text-base text-deep-green mb-1">Fair Pricing</h4>
            <p class="text-xs md:text-sm text-gray-600">No hidden fees</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <CallToAction text={`Get Your Free ${areaName} Quote`} />
  
  <!-- Nearby Areas Section -->
  <section class="py-4 md:py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-lg md:text-3xl font-bold mb-4 md:mb-6">Nearby Areas We Also Serve</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
          {nearbyAreas.map((nearbyArea: string) => (
            <a 
              href={`/areas/${nearbyArea.toLowerCase().replace(/ /g, '-')}/`}
              class="bg-bg-light p-3 md:p-4 rounded-lg hover:bg-fresh-green hover:text-white transition font-semibold text-sm md:text-base"
            >
              {nearbyArea}
            </a>
          ))}
        </div>
        <div class="mt-4 md:mt-6">
          <a href="/areas/" class="text-fresh-green font-semibold hover:text-deep-green text-sm md:text-base">
            View all areas →
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <HeroCTA />
  
  <Footer slot="footer" />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `${siteConfig.name} - ${areaName}`,
  "description": `Professional garden clearance, hedge cutting, landscaping and rubbish removal in ${areaName}, West Northamptonshire. Serving Monksmoor, Middlemore and surrounding villages. Fully insured, licensed waste carrier.`,
  "url": `${siteConfig.baseUrl}/areas/${areaName.toLowerCase().replace(/ /g, '-')}/`,
  "telephone": siteConfig.phone,
  "email": siteConfig.email,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": areaName,
    "addressRegion": "West Northamptonshire",
    "addressCountry": "GB"
  },
  "areaServed": {
    "@type": "City",
    "name": areaName
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": `Services in ${areaName}`,
    "itemListElement": services.map(service => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": service.title,
        "description": service.description
      }
    }))
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "opens": "08:00",
    "closes": "18:00"
  },
  "priceRange": "££"
})} />
