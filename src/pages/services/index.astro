---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import ProjectServices from '../../components/ProjectServices.astro';
import ProjectPlanning from '../../components/ProjectPlanning.astro';
import QuickQuoteBand from '../../components/QuickQuoteBand.astro';
import ProjectShowcase from '../../components/ProjectShowcase.astro';
---
<BaseLayout title="Landscaping Services Northampton | Patios & New Lawns" description="Explore landscaping, patio installation, turfing and garden renovations in Northampton. Real project photos and quotes for the agreed work.">
  <Header slot="header" />
  <Hero title="Landscaping Services in Northampton" subtitle="Patios, paving, new lawns and full garden renovations" heroImage="projects-2026/small-garden-makeover-after.webp" />
  <TrustBadges />
  <QuickQuoteBand service="a landscaping installation or garden renovation" />
  <ProjectServices />
  <ProjectShowcase />
  <ProjectPlanning />
  <section class="py-8 bg-bg-sage"><div class="container mx-auto px-4 max-w-4xl text-center"><h2 class="text-2xl font-bold mb-4">Other quoted services</h2><p class="mb-5">Standalone clearance and practical property jobs are also available. Send details of the work for a quote.</p><div class="flex flex-wrap gap-3 justify-center">{[{href:'garden-clearance',label:'Garden clearance'},{href:'hedge-cutting',label:'Hedge cutting & reduction'},{href:'clearance-removals',label:'Rubbish clearance'},{href:'man-with-van',label:'Man with van'},{href:'property-maintenance',label:'Property work'}].map(s=><a href={`/services/${s.href}/`} class="bg-white text-deep-green rounded-lg px-4 py-3 font-bold">{s.label}</a>)}</div></div></section>
  <Footer slot="footer" />
</BaseLayout>
