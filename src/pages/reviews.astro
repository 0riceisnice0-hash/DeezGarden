---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import HeroCTA from '../components/HeroCTA.astro';
import { siteConfig } from '../config';
import { reviews, aggregateRating } from '../data/reviews';
---

<BaseLayout 
  title={`Customer Reviews | ${aggregateRating.ratingValue}★ Gardener Northampton & Northamptonshire`}
  description={`Read ${aggregateRating.reviewCount}+ genuine 5-star Google reviews of Dee'z Gardens — professional garden maintenance, clearance, landscaping & rubbish removal across Northampton & Northamptonshire. Average rating ${aggregateRating.ratingValue}/5.`}
>
  <Header slot="header" />
  
  <Hero 
    heroImage="hero.jpg"
    title="Customer Reviews"
    subtitle={`Rated ${aggregateRating.ratingValue}★ on Google from ${aggregateRating.reviewCount}+ real customers`}
    showQuoteButton={true}
  />
  
  <TrustBadges />

  <!-- Aggregate rating banner -->
  <section class="py-4 md:py-6 bg-white border-b border-gray-100">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto flex flex-col sm:flex-row items-center justify-center gap-4 text-center">
        <div class="flex items-center gap-2">
          <div class="flex gap-0.5">
            {[1,2,3,4,5].map(() => (
              <svg class="w-6 h-6 md:w-7 md:h-7 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <span class="text-2xl md:text-3xl font-extrabold text-deep-green">{aggregateRating.ratingValue}</span>
          <span class="text-gray-600 text-sm md:text-base">/ 5</span>
        </div>
        <span class="hidden sm:block text-gray-300">|</span>
        <p class="text-sm md:text-base text-gray-700">
          <strong>{aggregateRating.reviewCount}+ verified reviews</strong> on Google
        </p>
        {siteConfig.googleBusinessProfile && (
          <a 
            href={siteConfig.googleBusinessProfile}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-fresh-green text-white font-bold px-4 py-2 rounded-lg hover:bg-deep-green transition shadow-md text-sm"
          >
            ⭐ Read on Google
          </a>
        )}
      </div>
    </div>
  </section>
  
  <section class="py-6 md:py-16 bg-bg-sage">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <p class="text-center text-sm md:text-lg mb-6 md:mb-12 text-gray-700">
          Don't take our word for it — here's what our customers are saying:
        </p>
        
        <div class="space-y-4 md:space-y-6">
          {reviews.map(review => (
            <article class="bg-white p-4 md:p-8 rounded-lg shadow-md border border-light-green/20">
              <div class="flex items-center mb-2 md:mb-4">
                <div class="flex gap-0.5 md:gap-1 mr-3 md:mr-4" aria-label={`${review.rating} out of 5 stars`}>
                  {[...Array(review.rating)].map(() => (
                    <svg class="w-4 h-4 md:w-5 md:h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  ))}
                </div>
                <div>
                  {review.title && <h3 class="font-bold text-sm md:text-lg">{review.title}</h3>}
                  {review.service && <p class="text-xs md:text-sm text-gray-600">{review.service}</p>}
                </div>
              </div>
              <p class="text-gray-700 italic mb-2 md:mb-4 text-sm md:text-base">
                "{review.text}"
              </p>
              <p class="text-xs md:text-sm text-gray-600">— {review.author}</p>
            </article>
          ))}
        </div>
        
        <div class="mt-8 md:mt-12 bg-white p-6 md:p-10 rounded-2xl text-center shadow-md border border-light-green/20">
          <h2 class="text-lg md:text-2xl font-bold mb-2 md:mb-4 text-deep-green">Join Our Satisfied Customers</h2>
          <p class="text-sm md:text-lg mb-4 md:mb-6 text-gray-700">
            Get in touch today for a free, no-obligation quote.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
            <a 
              href={`tel:${siteConfig.phone}`}
              class="inline-flex items-center gap-2 bg-fresh-green text-white font-extrabold px-6 py-3 rounded-lg hover:bg-deep-green transition shadow-lg w-full sm:w-auto justify-center"
            >
              📞 Call {siteConfig.phoneFormatted}
            </a>
            <button 
              type="button"
              class="quote-cta-btn inline-flex items-center gap-2 bg-deep-green text-white font-extrabold px-6 py-3 rounded-lg hover:bg-fresh-green transition shadow-lg w-full sm:w-auto justify-center cursor-pointer"
            >
              💬 Get a Free Quote
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <HeroCTA />
  
  <Footer slot="footer" />
</BaseLayout>
